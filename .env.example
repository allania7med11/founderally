# Every setting the stack reads. Names only; local defaults live in docker-compose.yml.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
# The researcher, worker on queue a only.
TAVILY_API_KEY=
OPENAI_MODEL=
# The LLM gateway holds the OpenAI key; the app calls it with one key, made by `make gateway-key`.
OPENAI_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_WORKER_KEY=
